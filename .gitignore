vs20*/
vsxmake*/
.vs/
.idea
compile_commands.json
code/scripting/CyberpunkSdk/CyberpunkSdk.csproj.user
code/scripting/JobSystem/Properties/PublishProfiles/FolderProfile.pubxml.user

