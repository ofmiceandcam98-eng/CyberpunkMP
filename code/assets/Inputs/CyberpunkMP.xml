<?xml version="1.0"?>
<bindings>
	<blend from="__ANY__" to="UI_Multiplayer" event="AXIS_RESET_TO_ZERO_NO_WAIT" />
	<blend from="__ANY__" to="UI_Multiplayer" event="BUTTON_RELEASE_IF_TO_DOESNT_CONTAIN" />
	<blend from="__ANY__" to="UI_ChatInput" event="AXIS_RESET_TO_ZERO_NO_WAIT" />
	<blend from="__ANY__" to="UI_ChatInput" event="BUTTON_RELEASE_IF_TO_DOESNT_CONTAIN" />
	<blend from="__ANY__" to="UI_EmoteSelection" event="AXIS_RESET_TO_ZERO_NO_WAIT" />
	<blend from="__ANY__" to="UI_EmoteSelection" event="BUTTON_RELEASE_IF_TO_DOESNT_CONTAIN" />
	<blend from="UI_EmoteSelection" to="__ANY__" event="AXIS_RESET_TO_ZERO_NO_WAIT" />
	<blend from="UI_EmoteSelection" to="__ANY__" event="BUTTON_RELEASE_IF_TO_DOESNT_CONTAIN" />

	<mapping name="UIConnectToServer_Button" type="Button" >
		<button id="IK_Slash" />
    </mapping>

	<mapping name="UIEmote_Button" type="Button" >
		<button id="IK_Period" />
    </mapping>

	<mapping name="UIShop_Button" type="Button" >
		<button id="IK_Comma" />
    </mapping>

	<mapping name="UIJob_Button" type="Button" >
		<button id="IK_Comma" />
    </mapping>
	
	<mapping name="UIDisconnectFromServer_Button" type="Button" >
		<button id="IK_Slash" />
    </mapping>

	<!-- Voice push-to-talk, default Y.
	     This is only the DEFAULT - the player remaps it in the launcher, so it just needs to
	     not collide out of the box. Three keys collided before Y: V is the native
	     summon-vehicle key (voice there ate the car spawn), T is the phone bind, and X is the
	     item/interaction key (zeldfep, 2026-09-10, walking it V -> T -> X -> Y). Y is free.
	     The voice system asks whether the VoicePushToTalk action is active and never asks
	     which key that is, so a rebind changes nothing downstream.
	     Both press and release are accepted below: hold-to-talk needs the release to know
	     when to stop, and toggle needs only the press. Same action serves both modes. -->
	<mapping name="VoicePushToTalk_Button" type="Button" >
		<button id="IK_Y" />
    </mapping>

	<!-- Cycling the voice range: whisper, local, yell.
	     A SEPARATE action from push-to-talk, and separately bindable. One decides WHEN
	     somebody talks, the other decides HOW FAR it carries, and combining them would
	     mean changing range required talking.
	     IK_F12 is a starting value like IK_V is. Only the press is accepted - cycling on
	     release as well would advance twice per tap. -->
	<mapping name="VoiceCycleRange_Button" type="Button" >
		<button id="IK_F12" />
    </mapping>

	<mapping name="UIEnterChatMessage_Button" type="Button" >
		<button id="IK_Semicolon" />
    </mapping>

	<!-- Mouse wheel, for scrolling the chat log.
	     There is no "mouse_wheel" action in the game - it exposes IK_MouseWheelUp and
	     IK_MouseWheelDown as separate buttons, and binds them to weapon switching and
	     zoom. Ours are declared under our own names and live only in the chat context,
	     so they cannot interfere with either during normal play. -->
	<mapping name="ChatScrollUp_Button" type="Button" >
		<button id="IK_MouseWheelUp" />
    </mapping>

	<mapping name="ChatScrollDown_Button" type="Button" >
		<button id="IK_MouseWheelDown" />
    </mapping>

	<mapping name="ChatTop_Button" type="Button" >
		<button id="IK_PageUp" />
    </mapping>

	<mapping name="ChatBottom_Button" type="Button" >
		<button id="IK_PageDown" />
    </mapping>

	<!-- Trade overlay keys. These exist because the overlay is a HUD widget: the menu
	     actions (navigate_up, proceed...) never dispatch without a UI context, and pushing
	     one half-captures input (the reverted test.50 modal). So the overlay gets plain
	     buttons in the gameplay chain instead - same mechanism as push-to-talk above.
	     Arrows/Enter/Backspace are unbound in gameplay, so nothing double-acts; the
	     listeners only register while the overlay is open (ChatController.MpTrOpen). -->
	<mapping name="TradeNavUp_Button" type="Button" >
		<button id="IK_Up" />
    </mapping>

	<mapping name="TradeNavDown_Button" type="Button" >
		<button id="IK_Down" />
    </mapping>

	<mapping name="TradeOfferLess_Button" type="Button" >
		<button id="IK_Left" />
    </mapping>

	<mapping name="TradeOfferMore_Button" type="Button" >
		<button id="IK_Right" />
    </mapping>

	<mapping name="TradeAccept_Button" type="Button" >
		<button id="IK_Enter" />
    </mapping>

	<mapping name="TradeExit_Button" type="Button" >
		<button id="IK_Backspace" />
    </mapping>
    
    <context name="UI_Multiplayer" >
		<include name="UINotifications" />
		<action name="sms_view_scroll_km" map="sms_view_scroll_km" priority="-1" />
    </context>

    <context name="UI_ChatInput" >
		<action name="EnterChat" map="EnterChat_Button" />
		<action name="back" map="back" />
        <action name="navigate_up" map="up_button" />
        <action name="navigate_down" map="down_button" />
        <action name="ChatTop" map="ChatTop_Button" />
        <action name="ChatBottom" map="ChatBottom_Button" />
        <action name="ChatScrollUp" map="ChatScrollUp_Button" />
        <action name="ChatScrollDown" map="ChatScrollDown_Button" />
    </context>

    <context name="UI_EmoteSelection" >
        <action name="UIEmote" map="UIEmote_Button" />		
		<action name="mouse_x" map="MouseX" priority="-1" />
		<action name="mouse_y" map="MouseY" priority="-1" />
    </context>

    <context name="UI_ShopSelection" >
        <action name="UIShop" map="UIShop_Button" />		
		<action name="mouse_x" map="MouseX" priority="-1" />
		<action name="mouse_y" map="MouseY" priority="-1" />
    </context>

    <hold action="UIConnectToServer" timeout="0.5" />
    <hold action="UIDisconnectFromServer" timeout="0.5" />
    <hold action="UIShop" timeout="0.5" />
    <hold action="UIJob" timeout="0.5" />

	<acceptedEvents action="UIConnectToServer">
		<event name="BUTTON_HOLD_COMPLETE" />
		<event name="BUTTON_HOLD_PROGRESS" />
		<event name="BUTTON_PRESSED" />
		<event name="BUTTON_RELEASED" />
	</acceptedEvents>

	<acceptedEvents action="UIDisconnectFromServer">
		<event name="BUTTON_HOLD_COMPLETE" />
		<event name="BUTTON_HOLD_PROGRESS" />
		<event name="BUTTON_PRESSED" />
		<event name="BUTTON_RELEASED" />
	</acceptedEvents>

	<acceptedEvents action="UIEnterChatMessage">
		<event name="BUTTON_PRESSED" />
		<event name="BUTTON_RELEASED" />
	</acceptedEvents>

	<acceptedEvents action="UIEmote">
		<event name="BUTTON_PRESSED" />
		<event name="BUTTON_RELEASED" />
	</acceptedEvents>

	<acceptedEvents action="UIShop">
		<event name="BUTTON_HOLD_COMPLETE" />
		<event name="BUTTON_HOLD_PROGRESS" />
		<event name="BUTTON_PRESSED" />
		<event name="BUTTON_RELEASED" />
	</acceptedEvents>

	<acceptedEvents action="UIJob">
		<event name="BUTTON_HOLD_COMPLETE" />
		<event name="BUTTON_HOLD_PROGRESS" />
		<event name="BUTTON_PRESSED" />
		<event name="BUTTON_RELEASED" />
	</acceptedEvents>

	<acceptedEvents action="VoicePushToTalk">
		<event name="BUTTON_PRESSED" />
		<event name="BUTTON_RELEASED" />
	</acceptedEvents>

	<!-- Press only. Accepting the release too would cycle twice for every tap. -->
	<acceptedEvents action="VoiceCycleRange">
		<event name="BUTTON_PRESSED" />
	</acceptedEvents>

	<!-- Trade keys: press only, same reasoning - a tap acts once. -->
	<acceptedEvents action="TradeNavUp">
		<event name="BUTTON_PRESSED" />
	</acceptedEvents>

	<acceptedEvents action="TradeNavDown">
		<event name="BUTTON_PRESSED" />
	</acceptedEvents>

	<acceptedEvents action="TradeOfferLess">
		<event name="BUTTON_PRESSED" />
	</acceptedEvents>

	<acceptedEvents action="TradeOfferMore">
		<event name="BUTTON_PRESSED" />
	</acceptedEvents>

	<acceptedEvents action="TradeAccept">
		<event name="BUTTON_PRESSED" />
	</acceptedEvents>

	<acceptedEvents action="TradeExit">
		<event name="BUTTON_PRESSED" />
	</acceptedEvents>

    <context name="UIBase" append="true">
        <action name="VoicePushToTalk" map="VoicePushToTalk_Button" />
        <action name="VoiceCycleRange" map="VoiceCycleRange_Button" />
        <action name="UIConnectToServer" map="UIConnectToServer_Button" />
        <action name="UIDisconnectFromServer" map="UIDisconnectFromServer_Button" />
        <action name="UIEnterChatMessage" map="UIEnterChatMessage_Button" />
        <action name="UIEmote" map="UIEmote_Button" />
        <action name="UIShop" map="UIShop_Button" />
        <action name="UIJob" map="UIJob_Button" />
        <action name="TradeNavUp" map="TradeNavUp_Button" />
        <action name="TradeNavDown" map="TradeNavDown_Button" />
        <action name="TradeOfferLess" map="TradeOfferLess_Button" />
        <action name="TradeOfferMore" map="TradeOfferMore_Button" />
        <action name="TradeAccept" map="TradeAccept_Button" />
        <action name="TradeExit" map="TradeExit_Button" />
    </context>

</bindings>