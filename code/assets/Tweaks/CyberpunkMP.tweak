	bool hasOnUpdate = false;
	CName affinity = "";
	CName[] alias = 
	[
		"allUIContexts"
	];
	bool hasEnterCondition = true;
	string[] transitionTo = 
	[
		"allForcedContexts", "allUIContexts", "gameplayContext"
	];
	string[] transitionCondition = 
	[
		"", "", "ExitCondition"
	];
	CName forceInputContext = "UI_Multiplayer";
}

