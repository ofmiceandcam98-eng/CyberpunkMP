Character.Muppet : Character.TPP_Player {
	// entityTemplatePath = "mods\cyberpunkmp\player_ma_tpp.ent";
	appearanceName = "TPP_Body";
	// appearanceName = "pma_default";
	// appearanceName = "character_creation";
	priority = "SpawnableObjectPriority.Regular";
	reactionPreset = "ReactionPresets.NoReaction";
	uiNameplate = "UINameplate.MpPlayerSettings";
	abilities += [ "Ability.CanCrouch", "Ability.CanSprint" ];

	// Cleared because this record INHERITS FROM Character.Panam, and with it her name.
	// That is why every remote player was labelled Panam regardless of who they were -
	// the nameplate reads the character record first and only falls back to the entity's
	// own display name when the record has none. Blanking these is what lets the name the
	// server sends actually reach the screen.
	displayName = "";
	fullDisplayName = "";
	alternativeDisplayName = "";
	// tags = [];
	// genders = [
	// 	{
	// 		initial = true;
	// 		gender = "Gender.Male";
	// 		entity = "mods\cyberpunkmp\player_ma_tpp.ent";
	// 	},
	// 	{
	// 		initial = false;
	// 		gender = "Gender.Female";
	// 		entity = "mods\cyberpunkmp\player_ma_tpp.ent";
	// 	}
	// ];
	
	// ours
	entityTemplatePath = "mods\cyberpunkmp\player_wa_fpp.ent";
	// genders = [
	// 	{
	// 		initial = true;
	// 		gender = "Gender.Female";
	// 		entity = "mods\cyberpunkmp\player_wa_fpp.ent";
	// 	}, 
	// 	{
	// 		gender = "Gender.Male";
	// 		entity = "mods\cyberpunkmp\player_ma_fpp.ent";
	// 	}
	// ];

	// From Panam
	// entityTemplatePath = "base\quest\primary_characters\panam.ent";
	// // this isn't
	// genders = [
	// 	{
	// 		initial = true;
	// 		gender = "Gender.Female";
	// 		entity = "base\quest\primary_characters\panam.ent";
	// 	}, 
	// 	{
	// 		gender = "Gender.Male";
	// 		entity = "base\quest\primary_characters\panam.ent";
	// 	}
	// ];

	// From TPP_Player
	// entityTemplatePath = "base\characters\entities\player\player_wa_fpp.ent";
	genders = [
		{
			initial = true;
			gender = "Gender.Female";
			entity = "base\characters\entities\player\player_wa_tpp.ent";
		}, 
		{
			gender = "Gender.Male";
			entity = "base\characters\entities\player\player_ma_tpp.ent";
		}
	];
}

Character.MaMuppet : Character.Panam {
	appearanceName = "TPP_Body";
	priority = "SpawnableObjectPriority.Regular";
	reactionPreset = "ReactionPresets.NoReaction";
	uiNameplate = "UINameplate.MpPlayerSettings";
	abilities += [ "Ability.CanCrouch", "Ability.CanSprint" ];

	// EXPERIMENT 1 - what a remote player needs to be a quickhack target.
	//
	// ScriptedPuppet.IsQuickHackAble() (scriptedPuppet.script:4045) refuses anything whose
	// record carries no object actions, and then refuses again unless at least one of them
	// is of type PuppetQuickHack. Panam has none, so a remote player could never be hacked
	// no matter what else was true of them.
	//
	// READ OFF A REAL NPC, NOT GUESSED. These are the quickhack entries on
	// Character.rcr_sixthstreet_hooligan_melee1_knife_wa - a Sixth Street hooligan the game
	// itself reported as IsQuickHackAble: true, dumped live from TweakDB.
	//
	// That mattered: the plausible-looking names in the game's own scripts are wrong.
	// QuickHack.BlindHack does not exist as a puppet action (it is BaseBlindHack), and
	// MadnessLvl3Hack is not the base record (it is MadnessHackBase). Copying what the
	// scripts appeared to say would have produced a record that silently did nothing.
	//
	// Deliberately NOT copied from that NPC: Takedown.*, GenericInteraction.* and
	// MinigameAction.* - takedowns, talk prompts and breach-protocol daemons are not
	// quickhacks and have no business on a player.
	objectActions += [
		"QuickHack.BaseOverheatHack",
		"QuickHack.BrainMeltBaseHack",
		"QuickHack.BaseContagionHack",
		"QuickHack.OverloadBaseHack",
		"QuickHack.SystemCollapseHackBase",
		"QuickHack.MadnessHackBase",
		"QuickHack.SuicideHackBase",
		"QuickHack.GrenadeHackBase",
		"QuickHack.BaseBlindHack",
		"QuickHack.BaseWeaponMalfunctionHack",
		"QuickHack.BaseLocomotionMalfunctionHack",
		"QuickHack.BaseCyberwareMalfunctionHack",
		"QuickHack.BaseMemoryWipeHack",
		"QuickHack.BasePingHack",
		"QuickHack.BaseCommsCallInHack",
		"QuickHack.BaseCommsNoiseHack",
		"QuickHack.BaseWhistleHack"
	];

	// Cleared because this record INHERITS FROM Character.Panam, and with it her name.
	// That is why every remote player was labelled Panam regardless of who they were -
	// the nameplate reads the character record first and only falls back to the entity's
	// own display name when the record has none. Blanking these is what lets the name the
	// server sends actually reach the screen.
	displayName = "";
	fullDisplayName = "";
	alternativeDisplayName = "";
	// entityTemplatePath = "mods\cyberpunkmp\player_ma_fpp.ent";
	// entityTemplatePath = "base\characters\entities\player\player_ma_tpp_cutscene.ent";
	entityTemplatePath = "mods\cyberpunkmp\player_ma_tpp_cutscene.ent";
	genders = 
	[
		{
			initial = true;
			gender = "Gender.Male";
			// entity = "mods\cyberpunkmp\player_ma_fpp.ent";
			// entity = "base\characters\entities\player\player_ma_tpp_cutscene.ent";
			entity = "mods\cyberpunkmp\player_ma_tpp_cutscene.ent";
		}
	];
}

Character.WaMuppet : Character.Panam {
	// The same quickhack actions as MaMuppet - see the note there for where they came from
	// and why the names in the game's scripts are not the ones that work. Repeated rather
	// than shared because these two records inherit from Panam, not from each other, which
	// is also why blanking her name had to be done twice.
	objectActions += [
		"QuickHack.BaseOverheatHack",
		"QuickHack.BrainMeltBaseHack",
		"QuickHack.BaseContagionHack",
		"QuickHack.OverloadBaseHack",
		"QuickHack.SystemCollapseHackBase",
		"QuickHack.MadnessHackBase",
		"QuickHack.SuicideHackBase",
		"QuickHack.GrenadeHackBase",
		"QuickHack.BaseBlindHack",
		"QuickHack.BaseWeaponMalfunctionHack",
		"QuickHack.BaseLocomotionMalfunctionHack",
		"QuickHack.BaseCyberwareMalfunctionHack",
		"QuickHack.BaseMemoryWipeHack",
		"QuickHack.BasePingHack",
		"QuickHack.BaseCommsCallInHack",
		"QuickHack.BaseCommsNoiseHack",
		"QuickHack.BaseWhistleHack"
	];

	appearanceName = "TPP_Body";
	// appearanceName = "panam_nude";
	priority = "SpawnableObjectPriority.Regular";
	reactionPreset = "ReactionPresets.NoReaction";
	uiNameplate = "UINameplate.MpPlayerSettings";
	abilities += [ "Ability.CanCrouch", "Ability.CanSprint" ];

	// Cleared because this record INHERITS FROM Character.Panam, and with it her name.
	// That is why every remote player was labelled Panam regardless of who they were -
	// the nameplate reads the character record first and only falls back to the entity's
	// own display name when the record has none. Blanking these is what lets the name the
	// server sends actually reach the screen.
	displayName = "";
	fullDisplayName = "";
	alternativeDisplayName = "";
	// entityTemplatePath = "mods\cyberpunkmp\player_wa_fpp.ent";
	// entityTemplatePath = "base\characters\entities\player\player_wa_tpp_cutscene.ent";
	entityTemplatePath = "mods\cyberpunkmp\player_wa_tpp_cutscene.ent";
	// entityTemplatePath = "base\quest\primary_characters\panam.ent";
	genders = 
	[
		{
			initial = true;
			gender = "Gender.Female";
			// entity = "mods\cyberpunkmp\player_wa_fpp.ent";
			// entity = "base\characters\entities\player\player_wa_tpp_cutscene.ent";
			entity = "mods\cyberpunkmp\player_wa_tpp_cutscene.ent";
			// entity = "base\quest\primary_characters\panam.ent";
		}
	];
}

