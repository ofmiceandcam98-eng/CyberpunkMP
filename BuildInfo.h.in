#pragma once
// This file was autogenerated by xmake
#define BUILD_BRANCH "${GIT_BRANCH}"
#define BUILD_COMMIT "${GIT_COMMIT}"

// The release this build ships as, stamped by Ship.ps1 through the NCO_BUILD_VERSION
// environment variable at build time. A build made without it is "0.0.0-dev" - which is
// the truth: nobody promised that build was any release at all. The numeric parts exist
// because RED4ext's PluginInfo wants a semver triple, and parsing a string in a macro is
// not a thing.
#define BUILD_VERSION "${NCO_VERSION}"
#define BUILD_VERSION_MAJOR ${NCO_VERSION_MAJOR}
#define BUILD_VERSION_MINOR ${NCO_VERSION_MINOR}
#define BUILD_VERSION_PATCH ${NCO_VERSION_PATCH}
