# Copy this file to .env and fill in the values, then: docker compose up -d
#
#   cp .env.example .env

# Credentials for the server's web/admin API. Release builds refuse to start
# without them (see code/server/loader/Systems/WebApi.cs).
#
# Note the admin API binds 0.0.0.0, so anyone who can reach the port can try
# these. Use a real password, and don't expose the TCP port to the internet.
CYBERPUNKMP_ADMIN_USERNAME=admin
CYBERPUNKMP_ADMIN_PASSWORD=

# Port for game traffic (UDP) and the web API (TCP). Clients connect with
#   --online --ip=<host> --port=<this>
CYBERPUNKMP_PORT=11778

# Where the Atlas (the cross-project mind map) lives, e.g. http://host:11782.
#
# Only the coordination API reads this, and it hands the answer out only to callers
# who prove the Discord dev role (POST /v1/atlas). It is deliberately NOT in any
# tracked file or in publish/server.json: server.json is a public release asset, and
# a player has no business learning this address. A dev's launcher fills the field in
# from here, so nobody types it.
#
# Leave empty and the endpoint answers 503 saying so - the launcher just falls back to
# the field being typed by hand.
NCO_ATLAS_URL=
